# Mock backend requires no model configuration.
# Live: set LLM_* below, or configure DASHSCOPE_API_KEY locally.
# DASHSCOPE_API_KEY selects qwen-plus at the Beijing compatible endpoint by default.
# Configure real credentials locally. Do not paste credentials into chat or commit them.
# Program reads process environment variables; it does not automatically load .env.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

MAX_MODEL_STEPS=24
MAX_TOOL_CALLS=20
MAX_RUNTIME_SECONDS=180
